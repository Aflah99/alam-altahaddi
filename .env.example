# Copy to `.env.local` for local development. Never commit real values.
# Only VITE_-prefixed variables are exposed to the browser, so they must be
# PUBLIC values. Secrets (service-role keys, AI API keys) belong in
# server-side functions (e.g. Supabase Edge Functions), never here.

# Supabase (added in a later task)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
